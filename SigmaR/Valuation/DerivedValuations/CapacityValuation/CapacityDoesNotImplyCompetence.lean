import SigmaR.StandingAlgebra_FormalCore

/-!
###############################################################################
# Capacity Does Not Imply Competence
###############################################################################

Capacity valuation does not imply competence, skill,
or adequacy relative to any task or role.

This prevents capacity valuation from being misread
as a performance or merit judgment.

This file introduces no axioms.
###############################################################################
-/

namespace SigmaR.Valuation.DerivedValuations.CapacityValuation

/--
Capacity valuation does not imply competence.
-/
axiom CapacityDoesNotImplyCompetence : Prop

end SigmaR.Valuation.DerivedValuations.CapacityValuation
