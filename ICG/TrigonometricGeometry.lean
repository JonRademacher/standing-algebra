module

public import ICG.DirectedPhaseGeometry

@[expose] public section

namespace ICG

namespace Envelope

open scoped RealInnerProductSpace

variable {Generator : Type*} [Fintype Generator]

/-- Alignment is measured by the cosine of the angle between envelopes. -/
noncomputable def alignment (x y : Envelope Generator) : ℝ :=
  Real.cos (angle x y)

/-- Orthogonal envelopes have zero alignment. -/
theorem alignment_eq_zero_of_inner_eq_zero {x y : Envelope Generator}
    (h : ⟪x, y⟫ = 0) : alignment x y = 0 := by
  unfold alignment angle
  rw [InnerProductGeometry.cos_angle]
  simp [h]

/-- The sine and cosine coordinates satisfy the fundamental trigonometric identity. -/
theorem trigonometric_identity (x y : Envelope Generator) :
    Real.sin (angle x y) ^ 2 + alignment x y ^ 2 = 1 := by
  simpa [alignment] using Real.sin_sq_add_cos_sq (angle x y)

/-- Alignment is symmetric because the underlying angle is symmetric. -/
theorem alignment_symmetric (x y : Envelope Generator) :
    alignment x y = alignment y x := by
  simp [alignment, angle_symmetric]

/-- Orthogonal projection onto the line generated by a nonzero envelope retains
its angular component and leaves an orthogonal residual. -/
theorem line_projection_residual_orthogonal (x y : Envelope Generator) :
    x - (ℝ ∙ y).starProjection x ∈ (ℝ ∙ y)ᗮ :=
  Submodule.sub_starProjection_mem_orthogonal (K := ℝ ∙ y) x

end Envelope

end ICG
