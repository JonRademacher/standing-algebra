module

public import Mathlib.RingTheory.Nullstellensatz

@[expose] public section

namespace ICG

open MvPolynomial

variable {k : Type*} [Field k] {σ : Type*}

/-- A polynomial derivation from generators, closed under addition and scalar multiples. -/
inductive IdealDerivation (generators : Set (MvPolynomial σ k)) :
    MvPolynomial σ k → Prop
  | generator {p} : p ∈ generators → IdealDerivation generators p
  | zero : IdealDerivation generators 0
  | add {p q} :
      IdealDerivation generators p →
      IdealDerivation generators q →
      IdealDerivation generators (p + q)
  | smul (r : MvPolynomial σ k) {p} :
      IdealDerivation generators p →
      IdealDerivation generators (r • p)

/-- Interaction derivability in the polynomial model is exactly ideal membership. -/
theorem idealDerivation_iff_mem_span {generators : Set (MvPolynomial σ k)}
    {p : MvPolynomial σ k} :
    IdealDerivation generators p ↔ p ∈ Ideal.span generators := by
  constructor
  · intro h
    induction h with
    | generator hp =>
        exact Ideal.subset_span hp
    | zero =>
        exact Ideal.zero_mem _
    | add _ _ hp hq =>
        exact Ideal.add_mem _ hp hq
    | smul r _ hp =>
        exact Submodule.smul_mem _ r hp
  · intro hp
    induction hp using Submodule.span_induction with
    | mem p hp =>
        exact IdealDerivation.generator hp
    | zero =>
        exact IdealDerivation.zero
    | add _ _ _ _ hp hq =>
        exact IdealDerivation.add hp hq
    | smul r _ _ hp =>
        exact IdealDerivation.smul r hp

/-- The polynomial interaction closure generated by a constraint family. -/
def polynomialClosure (generators : Set (MvPolynomial σ k)) :
    Set (MvPolynomial σ k) :=
  {p | IdealDerivation generators p}

theorem polynomialClosure_eq_span (generators : Set (MvPolynomial σ k)) :
    polynomialClosure generators = Ideal.span generators := by
  ext p
  exact idealDerivation_iff_mem_span

variable {K : Type*} [Field K] [Algebra k K]

/-- The admissible states of polynomial constraints are their common zeroes. -/
def variety (generators : Set (MvPolynomial σ k)) : Set (σ → K) :=
  MvPolynomial.zeroLocus K (Ideal.span generators)

theorem mem_variety_iff {generators : Set (MvPolynomial σ k)} {x : σ → K} :
    x ∈ variety (k := k) (K := K) generators ↔
      ∀ p ∈ generators, MvPolynomial.aeval x p = 0 := by
  rw [variety, MvPolynomial.zeroLocus_span]
  rfl

variable [IsAlgClosed K] [Finite σ]

/-- Hilbert's Nullstellensatz: the polynomials vanishing on an ideal's zero locus
form precisely its radical. This is Mathlib's proved theorem. -/
theorem vanishingIdeal_zeroLocus_eq_radical (I : Ideal (MvPolynomial σ k)) :
    MvPolynomial.vanishingIdeal k (MvPolynomial.zeroLocus K I) = I.radical :=
  MvPolynomial.vanishingIdeal_zeroLocus_eq_radical I

/-- A polynomial vanishes at every common zero of an ideal exactly when
it belongs to the radical of that ideal. -/
theorem vanishes_on_variety_iff_mem_radical
    (I : Ideal (MvPolynomial σ k)) (p : MvPolynomial σ k) :
    (∀ x ∈ MvPolynomial.zeroLocus K I, MvPolynomial.aeval x p = 0) ↔ p ∈ I.radical := by
  rw [← MvPolynomial.mem_vanishingIdeal_iff,
    MvPolynomial.vanishingIdeal_zeroLocus_eq_radical]

end ICG
