module

public import ICG.ObstructionGeometry

@[expose] public section

namespace ICG

universe u

variable {Constraint : Type u}

/-- Explicit contradiction generated by interaction closure. -/
def StrongObstruction (rules : InteractionSystem Constraint)
    (seeds : Set Constraint) (obstruction : Constraint) : Prop :=
  Derives rules seeds obstruction

/-- Strong obstruction already generated by at least one subsystem. -/
def InternalStrongObstruction (rules : InteractionSystem Constraint)
    (left right : Set Constraint) (obstruction : Constraint) : Prop :=
  Derives rules left obstruction ∨ Derives rules right obstruction

/-- Strong obstruction generated only after combining two subsystems. -/
def EmergentStrongObstruction (rules : InteractionSystem Constraint)
    (left right : Set Constraint) (obstruction : Constraint) : Prop :=
  IsEmergent (rules := rules) left right obstruction

/-- Unresolved, mutually incompatible extension pressures are weak tension. -/
def WeakTensionObstruction (rules : InteractionSystem Constraint)
    (seeds : Set Constraint) (obstruction : Constraint)
    (incompatible : Constraint → Constraint → Prop) : Prop :=
  ¬ StrongObstruction rules seeds obstruction ∧
    ∃ a b, Derives rules seeds a ∧ Derives rules seeds b ∧ incompatible a b

/-- Every strong obstruction is internal or emergent, and the alternatives are exclusive. -/
theorem strong_obstruction_classification (rules : InteractionSystem Constraint)
    (left right : Set Constraint) (obstruction : Constraint)
    (h : StrongObstruction rules (left ∪ right) obstruction) :
    InternalStrongObstruction rules left right obstruction ∨
      EmergentStrongObstruction rules left right obstruction := by
  by_cases hleft : Derives rules left obstruction
  · exact Or.inl (Or.inl hleft)
  · by_cases hright : Derives rules right obstruction
    · exact Or.inl (Or.inr hright)
    · exact Or.inr ⟨h, hleft, hright⟩

theorem internal_and_emergent_disjoint (rules : InteractionSystem Constraint)
    (left right : Set Constraint) (obstruction : Constraint) :
    ¬ (InternalStrongObstruction rules left right obstruction ∧
      EmergentStrongObstruction rules left right obstruction) := by
  rintro ⟨hint | hint, ⟨_, hnotLeft, hnotRight⟩⟩
  · exact hnotLeft hint
  · exact hnotRight hint

theorem weak_tension_not_strong (rules : InteractionSystem Constraint)
    (seeds : Set Constraint) (obstruction : Constraint)
    (incompatible : Constraint → Constraint → Prop) :
    WeakTensionObstruction rules seeds obstruction incompatible →
      ¬ StrongObstruction rules seeds obstruction :=
  And.left

end ICG
